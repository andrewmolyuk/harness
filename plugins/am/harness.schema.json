{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "harness config",
  "description": "A project's settings for the am plugin's hooks (.harness.json).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "guard": {
      "description": "Extra commands for the guard to block, on top of its built-in rules.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "block": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pattern", "reason"],
            "properties": {
              "pattern": {
                "description": "A regular expression matched against the command text.",
                "type": "string",
                "format": "regex"
              },
              "reason": { "description": "Why the command is blocked.", "type": "string" }
            }
          }
        }
      }
    },
    "gitHooks": {
      "description": "Git hooks to generate: each runs its entries in order and stops at the first failure. A Git hook is installed only when its key is present.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pre-commit": {
          "type": "array",
          "items": {
            "anyOf": [{ "enum": ["am:adr-immutable"] }, { "$ref": "#/definitions/command" }]
          }
        },
        "commit-msg": {
          "type": "array",
          "items": {
            "anyOf": [
              { "enum": ["am:conventional-commits", "am:no-ai-coauthor"] },
              { "$ref": "#/definitions/command" }
            ]
          }
        },
        "pre-push": {
          "type": "array",
          "items": {
            "anyOf": [{ "enum": ["am:linear-history"] }, { "$ref": "#/definitions/command" }]
          }
        }
      }
    }
  },
  "definitions": {
    "command": {
      "description": "A shell command; it gets the Git hook's arguments as $1… and, for pre-push, its stdin.",
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^am:" }
    }
  }
}
