{
  "$schema": "https://raw.githubusercontent.com/andrewmolyuk/harness/main/plugins/am/harness.schema.json",
  "statusLine": true,
  "sessionReview": true,
  "guidelines": true,
  "gitHooks": {
    "commit-msg": ["am:conventional-commits", "am:no-ai-coauthor"],
    "pre-commit": ["am:adr-immutable", "am:no-secrets", "bun run check"],
    "pre-push": ["am:linear-history"]
  },
  "guard": { "block": [] }
